+// --- Local workaround (not upstream JUCE) ------------------------------------
+// CGWindowListCreateImage is marked unavailable ("obsoleted in macOS 15.0") in
+// the macOS 15 SDK shipped with Xcode 16, which breaks the JUCE 7 build. The
+// symbol still exists in CoreGraphics, so we re-declare it under a different
+// name with an asm() alias to the real symbol; this sidesteps the SDK's
+// unavailability attribute. Remove when moving to a JUCE version that uses
+// ScreenCaptureKit (JUCE 8.x).
+extern "C" CGImageRef juce_CGWindowListCreateImage (CGRect, CGWindowListOption,
+                                                    CGWindowID, CGWindowImageOption)
+    __asm("_CGWindowListCreateImage");
+// -----------------------------------------------------------------------------
+
 namespace juce
